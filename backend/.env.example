# OrderFlow Backend Environment Configuration
# Copy this file to backend/.env and adjust values for your local environment.

# PostgreSQL Connection String (uses psycopg 3)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/orderflow

# Supabase Auth Configuration
SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY is required for salesman provisioning by Order Desk
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Allowed CORS Origins (comma-separated for multiple origins)
ORDERFLOW_CORS_ORIGINS=http://localhost:5173

# Google Gemini API (Optional - demo fallback used if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
